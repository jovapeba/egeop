# ==============================================================================
# eGeopolis Production Environment Configuration (Vultr / Docker Compose)
# ==============================================================================

# Database Credentials
# (Note: Keep password alphanumeric or URL-encoded to prevent URL parse issues)
POSTGRES_USER=nationforge
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD_123
POSTGRES_DB=nationforge
POSTGRES_PORT=5434

# DATABASE_URL is automatically constructed by docker-compose from the variables above.
# If you prefer to specify the full connection string directly, uncomment and set:
# DATABASE_URL=postgresql://nationforge:CHANGE_THIS_TO_A_SECURE_PASSWORD_123@postgres:5432/nationforge?schema=public

# Redis Port on Host
REDIS_PORT=6379

# Production Security Secrets
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_LONG_SECRET_KEY_FOR_JWT

# Public URLs & Domain Routing
# Replace with your actual domain or Vultr server IP
# Example with Domain:
#   WEB_ORIGIN=https://egeopolis.com
#   NEXT_PUBLIC_API_URL=https://api.egeopolis.com
#   NEXT_PUBLIC_WS_URL=https://api.egeopolis.com
# Example with Vultr Server IP (e.g., 207.148.x.x):
#   WEB_ORIGIN=http://207.148.x.x:3000
#   NEXT_PUBLIC_API_URL=http://207.148.x.x:3001
#   NEXT_PUBLIC_WS_URL=http://207.148.x.x:3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Exposed Ports on Host
API_PORT=3001
WEB_PORT=3000

# Seeding: Seeds 54 countries, political organs, demo accounts on empty database
SEED_ON_BOOT=true
