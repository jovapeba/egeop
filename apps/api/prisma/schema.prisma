// NationForge — Prisma schema
// Game inspired by e-Sim (e-sim.org). Formula sources: esim.fandom.com wiki.
// Money: integer minor units (1 currency unit = 100). Gold: integer minor units (1g = 100).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Resource {
  GRAIN
  SUGAR
  GUNPOWDER
  STONE
  WOOD
  PETROL
}

enum Density {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum Product {
  GRAIN
  SUGAR
  GUNPOWDER
  STONE
  WOOD
  PETROL
  AMMO
  FOOD
  ENERGY_DRINK
  PANTRY
  FRIDGE
  HOSPITAL
  FORTIFICATION
  MILITARY_AIR_BASE
  MILITARY_NAVY_BASE
  TICKET
  FIRST_AID_KIT
  SPECIAL_ITEM
}

enum EquipmentSlot {
  MUZZLE
  LASER
  OPTIC
  STOCK
  REAR_GRIP
  MAGAZINE
  BARREL
  UNDERBARREL
}

enum CountryType {
  PLAYABLE
  NEUTRAL
  STAFF
}

enum RegionKind {
  CAPITAL
  RAW
  NON_RAW
  BRIDGE
  GUNPOWDER
  PRISON
}

enum StorageOwnerType {
  CITIZEN
  COMPANY
  JSC
  COUNTRY
  MILITARY_UNIT
}

enum MarketOwnerType {
  CITIZEN
  COMPANY
  JSC
  COUNTRY
}

enum WarType {
  DIRECT
  RESISTANCE
  CIVIL
}

enum WarStatus {
  ACTIVE
  ENDED
}

enum BattleStatus {
  ACTIVE
  ENDED
}

enum RoundStatus {
  ACTIVE
  ENDED
}

enum BattleSide {
  ATTACKER
  DEFENDER
}

enum HitMode {
  SINGLE
  BERSERK
}

enum CivilPollStatus {
  VOTING
  FAILED
  PASSED
}

enum StockSide {
  SELL
  BUY
}

enum LawType {
  DECLARE_WAR
  ATTACK_REGION
  CEASEFIRE
  NAP
  JOIN_ALLIANCE
  LEAVE_ALLIANCE
  CREATE_ALLIANCE
  PROPOSE_MDMA
  CANCEL_MDMA
  RIVAL_COUNTRY
  DEPLOY_BUILDING
  DEMOLISH_BUILDING
  CHANGE_TAX
  PRINT_MONEY
  SET_MIN_SALARY
  MARKETPLACE_EMBARGO
  JOB_EMBARGO
  MONETARY_EMBARGO
  CANCEL_EMBARGO
  IMPEACH
  ELECT_PRESIDENT
  REVOKE_CITIZENSHIP
  CITIZENSHIP_REQUEST
  TREASURY_TRANSFER
  ISSUE_BONDS
}

enum LawStatus {
  VOTING
  ACCEPTED
  REJECTED
  EXPIRED
  EXECUTED
  FAILED
}

enum ElectionType {
  PRESIDENTIAL
  PARTY_LEADER
  CONGRESS
}

enum NewsCategory {
  POLITICS
  WAR
  ECONOMY
  FUN_OTHER
}

enum EmbargoType {
  MARKETPLACE
  JOB
  MONETARY
}

enum BuffType {
  STEROID
  RAMBO
  PATRIOT
  REBEL
}

enum ContractType {
  LOAN
  PACK_SALE
}

enum ContractStatus {
  OPEN
  ACCEPTED
  COMPLETED
  CANCELLED
  DEFAULTED
}

enum AuctionItemKind {
  WA
  SPECIAL_ITEM
}

enum AuctionStatus {
  ACTIVE
  SOLD
  CANCELLED
}

enum TournamentType {
  GUNPOWDER_CUP
  GLOBAL_WAR
  ARMY_CUP
  COUNTRY_CUP
  QUICKDROP_CUP
  ONE_VS_ONE
  FIRST_AID
}

enum TournamentStatus {
  REGISTERING
  RUNNING
  FINISHED
}

enum ElectionStatus {
  CANDIDATURE
  VOTING
  CLOSED
}

enum MuRank {
  COMMANDER
  CAPTAIN
  RECRUIT
}

enum MuApplicationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ShoutScope {
  GLOBAL
  COUNTRY
  MILITARY_UNIT
}

enum OfferStatus {
  ACTIVE
  FILLED
  CANCELLED
}

enum TxAsset {
  GOLD
  FIAT
}

enum TxReason {
  STARTER
  SALARY
  WAGE_PAYMENT
  TAX
  MARKET_PURCHASE
  MARKET_SALE
  MONETARY_TRADE
  MEDAL
  LEVEL_UP
  LAW_EXECUTION
  TREASURY_TRANSFER
  PRINT_MONEY
  WAR_DECLARE
  REGION_ATTACK
  RW_START
  CIVIL_START
  SUBSIDY
  MERGE_FEE
  AUCTION_FEE
  JSC_CREATE
  JSC_DIVIDEND
  STOCK_TRADE
  STOCK_TRADE_FEE
  JSC_SHARE_ISSUE
  JSC_DONATION
  JSC_LIQUIDATION
  TREATY_FEE
  MU_CREATE
  MU_EXPAND
  COMPANY_CREATE
  COMPANY_UPGRADE
  COMPANY_RELOCATE
  COMPANY_INDUSTRY
  COMPANY_SALE
  NEWSPAPER_CREATE
  TIP
  BOND_ISSUE
  BOND_REDEEM
  OTHER
}

// ============================================================================
// WORLD
// ============================================================================

model Country {
  id              String       @id @default(cuid())
  name            String       @unique
  code            String       @unique @db.VarChar(4)
  type            CountryType  @default(PLAYABLE)
  svgPath         String? // world.svg path (map rendering)
  continent       String?
  flagColor       String       @default("#4a6de8") @db.VarChar(16)
  currencyName    String
  currencySymbol  String       @db.VarChar(4)
  treasuryGold    BigInt       @default(0) // minor gold units (National Organisation treasury)
  treasuryFiat    BigInt       @default(0) // minor currency units
  minSalary       BigInt       @default(1000) // minor units per working day
  active          Boolean      @default(true)
  rivalOf         String?
  rivalUntil      DateTime?
  broadcastMessage   String?
  broadcastExpiresAt DateTime?
  createdAt       DateTime     @default(now())

  regions        Region[]
  coreRegions    Region[] @relation("coreRegions")
  taxes          CountryTax[]
  presidentId    String?
  president      Citizen? @relation("countryPresident", fields: [presidentId], references: [id])
  laws           Law[]
  elections      Election[]
  parties        Party[]
  warsA          War[] @relation("warAttacker")
  warsB          War[] @relation("warDefender")
  treatiesA      Treaty[] @relation("treatyA")
  treatiesB      Treaty[] @relation("treatyB")
  bonds          Bond[]
  subsidies      Subsidy[]
  citizens       Citizen[]
  wallets        CitizenWallet[]
  organisation   NationalOrganisation?
  embargosOn     Embargo[] @relation("embargoTarget")
  embargosBy     Embargo[] @relation("embargoSource")
  allianceMember AllianceMember[]
  chatMessages   CountryChatMessage[]
}

model CountryTax {
  id        String   @id @default(cuid())
  countryId String
  product   Product
  vat       Int      @default(1) // %
  importTax Int      @default(1) // %
  country   Country  @relation(fields: [countryId], references: [id])
  incomeTax Int      @default(25) // % on wages

  @@unique([countryId, product])
}

model Region {
  id            String      @id @default(cuid())
  name          String
  countryId     String // current owner
  coreCountryId String // rightful owner
  kind          RegionKind  @default(NON_RAW) // CAPITAL / RAW / NON_RAW / BRIDGE / GUNPOWDER / PRISON
  isCapital     Boolean     @default(false)
  isPort        Boolean     @default(false) // allows MILITARY_NAVY_BASE
  resource      Resource?
  density       Density     @default(NONE)
  x             Float // map cell coordinates (source SVG viewBox space)
  y             Float
  population    Int         @default(100)
  attackCooldownUntil DateTime? // air/navy base 1h attack cooldown
  createdAt     DateTime    @default(now())

  country    Country  @relation(fields: [countryId], references: [id])
  coreCountry Country @relation("coreRegions", fields: [coreCountryId], references: [id])
  companies  Company[]
  citizens   Citizen[]
  battles    Battle[]
  buildings  RegionBuilding[]
  neighborsA RegionNeighbor[] @relation("neighborA")
  neighborsB RegionNeighbor[] @relation("neighborB")

  @@index([countryId])
}

model RegionNeighbor {
  aId String
  bId String

  a Region @relation("neighborA", fields: [aId], references: [id])
  b Region @relation("neighborB", fields: [bId], references: [id])

  @@id([aId, bId])
}

model RegionBuilding {
  id        String   @id @default(cuid())
  regionId  String
  type      Product // HOSPITAL or DEFENSE_SYSTEM
  quality   Int      @default(1)
  createdAt DateTime @default(now())

  region Region @relation(fields: [regionId], references: [id])

  @@unique([regionId, type])
}

// ============================================================================
// CITIZENS
// ============================================================================

model Citizen {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  nickname      String   @unique
  avatarColor   String   @default("#5aa2e8") @db.VarChar(16)
  isBot         Boolean  @default(false)
  isAdmin       Boolean  @default(false)
  createdAt     DateTime @default(now())

  // Progression
  level        Int    @default(1)
  xp           Int    @default(0)
  hp           Int    @default(50)
  strength     Float  @default(10)
  ecoSkill     Float  @default(1)
  totalDamage  BigInt @default(0)

  // Day-cycle state (server day numbers)
  lastRegenAt        DateTime @default(now())
  workedOnDay        Int      @default(0)
  trainedOnDay       Int      @default(0)
  foodUsed           Int      @default(0)
  giftUsed           Int      @default(0)
  foodLimitExtra     Int      @default(0) // extra vacations
  giftLimitExtra     Int      @default(0) // extra spa
  hospitalUsedOnDay  Int      @default(0)

  // Streaks
  workTotalDays       Int @default(0)
  workStreak          Int @default(0)
  lastWorkedDay       Int @default(0)
  trainTotalSessions  Int @default(0)
  trainStreak         Int @default(0)
  lastTrainedDay      Int @default(0)

  // Wallet
  gold BigInt @default(0) // minor gold units

  // Location & citizenship
  citizenshipCountryId String
  locationRegionId     String

  // Security / staff audit
  lastIp      String? // recorded at login; shared-IP audit table (staff deck)
  lastSeenAt  DateTime @default(now()) // refreshed on login/me; 30-day inactivity liquidation

  // Referrals
  referrerId  String?
  referralCode String   @unique @default(cuid())
  societyBuilderCount Int @default(0) // referrals that reached L9/L13
  referralLevelsPaid Int @default(0) // last level paid out for (0.5g/level)
  referralMedalsPaid Int @default(0) // medals counted for 0.5g share

  firstAidKits     Int  @default(0)
  premiumDaysLeft  Int  @default(0)
  guide            String @default("MAN") // tutorial guide character: MAN | WOMAN | CHICKEN
  enableTutorial   Boolean @default(true)
  shortcuts        Json   @default("[]") // customizable sidebar hotlist (up to 5 route keys)
  pantryDaysLeft   Int  @default(0) // Pantry: +10 food limit, 60-day lifespan, wood-repairable
  fridgeDaysLeft   Int  @default(0) // Fridge: +10 energy drink limit, 60-day lifespan, stone-repairable
  adWatchOnDay     Int  @default(0) // +5 food limits once/day
  freeFlightsToday Int  @default(0)

  citizenshipCountry Country        @relation(fields: [citizenshipCountryId], references: [id])
  locationRegion     Region         @relation(fields: [locationRegionId], references: [id])
  referrer           Citizen?       @relation("referrals", fields: [referrerId], references: [id])
  referrals          Citizen[]      @relation("referrals")
  equipped           EquippedSlot[]
  employment         Employment[]
  shares             Share[]
  stockOrders        StockOrder[]
  monetaryOffers     MonetaryOffer[]
  articles           Article[]
  articleVotes       ArticleVote[]
  subscriptions      Subscription[]
  shouts             Shout[]
  medals             Medal[]
  notifications      Notification[]
  votes              Vote[]
  warsStarted        War[]           @relation("rwInitiator")
  lawVotes           LawVote[]
  candidacies        Candidacy[]
  partyMemberships   PartyMembership[]
  muMemberships      MuMembership[]
  muApplications     MuApplication[]
  hits               BattleHit[]
  congressSeats      CongressSeat[]
  ministerRoles      Minister[]
  partiesLed         Party[]         @relation("partyLeader")
  presidentOf        Country[]       @relation("countryPresident")
  equipmentOffers    EquipmentOffer[] @relation("equipmentOfferOwner")
  bondsIssued        Bond[]           @relation("bondHolder")
  wallets            CitizenWallet[]
  stocksCeoOf        StockCompany[]   @relation("jscCeo")
  chatMessages       CountryChatMessage[]
  buffs              Buff[]
  contractsCreated   Contract[]       @relation("contractCreator")
  contractsTaken     Contract[]       @relation("contractCounterparty")
  bids               AuctionBid[]
  citizenshipRequests CitizenshipRequest[] @relation("citizenshipRequester")
  newsPortal         NewsPortal?
  sharedIpMainRows   SharedIpRegistration[] @relation("sharedIpMain")
  sharedIpSharedRows SharedIpRegistration[] @relation("sharedIpShared")
  friendsRequested   Friendship[] @relation("friendRequester")
  friendsReceived    Friendship[] @relation("friendAddressee")
  pmsSent            PrivateMessage[] @relation("pmSender")
  pmsReceived        PrivateMessage[] @relation("pmRecipient")

  @@index([citizenshipCountryId])
  @@index([locationRegionId])
}

model EquippedSlot {
  citizenId String
  slot      EquipmentSlot
  itemId    String

  citizen Citizen        @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  item    EquipmentItem  @relation(fields: [itemId], references: [id])

  @@id([citizenId, slot])
}

// ============================================================================
// STORAGE & ITEMS
// ============================================================================

model Storage {
  id        String  @id @default(cuid())
  ownerType StorageOwnerType
  ownerId   String
  product   Product
  quality   Int     @default(0) // 0 for raw & medkits
  quantity  BigInt  @default(0)

  @@unique([ownerType, ownerId, product, quality])
  @@index([ownerType, ownerId])
}

model EquipmentItem {
  id          String        @id @default(cuid())
  ownerType   StorageOwnerType @default(CITIZEN)
  ownerId     String
  slot        EquipmentSlot
  quality     Int
  name        String
  params      Json // GearParam[]
  description String?
  createdAt   DateTime      @default(now())

  slots EquippedSlot[]
  offers EquipmentOffer[]
}

// ============================================================================
// COMPANIES & JOBS
// ============================================================================

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  ownerId     String // citizen id or StockCompany id (see ownerType)
  ownerType   MarketOwnerType @default(CITIZEN)
  organisationId String? // set when the National Organisation owns it
  product     Product
  quality     Int      @default(1)
  regionId    String
  fiatWallet  BigInt   @default(0) // local currency, minor units
  forSale     Boolean  @default(false)
  salePrice   BigInt   @default(0) // gold minor units
  createdAt   DateTime @default(now())

  region       Region   @relation(fields: [regionId], references: [id])
  employees    Employment[]
  jobOffers    JobOffer[]
  workedToday  WorkedToday[]
  organisation NationalOrganisation? @relation("orgCompanies", fields: [organisationId], references: [id])
}

model WorkedToday {
  companyId String
  day       Int
  count     Int @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, day])
}

model JobOffer {
  id          String  @id @default(cuid())
  companyId   String
  minEcoSkill Float   @default(1)
  salary      BigInt // minor units per day (gross)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
}

model Employment {
  id           String   @id @default(cuid())
  citizenId    String
  companyId    String
  salary       BigInt
  startedAt    DateTime @default(now())
  active       Boolean  @default(true)

  citizen Citizen @relation(fields: [citizenId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([citizenId, active])
}

// ============================================================================
// STOCK COMPANIES (JSC)
// ============================================================================

model StockCompany {
  id          String   @id @default(cuid())
  name        String   @unique
  ceoId       String
  treasuryGold BigInt  @default(0) // minor gold units
  sharesTotal Int      @default(1000)
  issuePrice  BigInt   @default(100) // 1g default: price when the JSC issues new shares
  createdAt   DateTime @default(now())

  ceo      Citizen      @relation("jscCeo", fields: [ceoId], references: [id])
  shares   Share[]
  orders   StockOrder[]
  dividends Dividend[]
  polls    JscPoll[]
}

model Share {
  id            String @id @default(cuid())
  jscId         String
  holderCitizenId String
  quantity      Int    @default(0)

  jsc    StockCompany @relation(fields: [jscId], references: [id])
  holder Citizen       @relation(fields: [holderCitizenId], references: [id])

  @@unique([jscId, holderCitizenId])
}

model StockOrder {
  id        String   @id @default(cuid())
  jscId     String
  ownerId   String
  side      StockSide
  quantity  Int
  price     BigInt // gold minor units per share
  remaining Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  jsc    StockCompany @relation(fields: [jscId], references: [id])
  owner  Citizen      @relation(fields: [ownerId], references: [id])
  trades StockTrade[]
}

model StockTrade {
  id        String   @id @default(cuid())
  orderId   String
  buyerId   String
  sellerId  String
  quantity  Int
  price     BigInt
  createdAt DateTime @default(now())

  order StockOrder @relation(fields: [orderId], references: [id])
}

model Dividend {
  id        String   @id @default(cuid())
  jscId     String
  totalGold BigInt
  perShare  BigInt
  createdAt DateTime @default(now())

  jsc StockCompany @relation(fields: [jscId], references: [id])
}

// ============================================================================
// MARKETS
// ============================================================================

model ProductOffer {
  id        String   @id @default(cuid())
  ownerId   String
  ownerType MarketOwnerType @default(CITIZEN)
  countryId String // market (country) it is sold on
  product   Product
  quality   Int      @default(1)
  unitPrice BigInt // minor units per piece (before VAT)
  stock     Int      @default(0)
  remaining Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([countryId, product, quality, active])
}

model ProductPurchase {
  id        String   @id @default(cuid())
  offerId   String
  buyerId   String
  sellerId  String
  product   Product
  quality   Int
  quantity  Int
  unitPrice BigInt
  vatPaid   BigInt
  importPaid BigInt
  createdAt DateTime @default(now())
}

model MonetaryOffer {
  id        String   @id @default(cuid())
  ownerId   String
  sellAsset TxAsset // GOLD or FIAT
  sellCountryId String? // required when FIAT
  sellAmount BigInt
  remaining BigInt
  rate      Decimal  @db.Decimal(18, 8) // buy-asset units per 1 sell unit
  buyAsset  TxAsset
  buyCountryId String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  owner  Citizen         @relation(fields: [ownerId], references: [id])
  trades MonetaryTrade[]
}

model MonetaryTrade {
  id        String   @id @default(cuid())
  offerId   String
  buyerId   String
  sellerId  String
  sellAsset TxAsset
  buyAsset  TxAsset
  sellCountryId String?
  buyCountryId  String?
  sellAmount BigInt
  buyAmount  BigInt
  rate      Decimal  @db.Decimal(18, 8)
  createdAt DateTime @default(now())

  offer MonetaryOffer @relation(fields: [offerId], references: [id])
}

model EquipmentOffer {
  id        String   @id @default(cuid())
  ownerId   String
  itemId    String
  price     BigInt // gold minor units
  buyerId   String?
  status    OfferStatus @default(ACTIVE)
  createdAt DateTime @default(now())

  owner Citizen        @relation("equipmentOfferOwner", fields: [ownerId], references: [id])
  item  EquipmentItem  @relation(fields: [itemId], references: [id])
}

model Bond {
  id          String   @id @default(cuid())
  countryId   String
  holderId    String
  principal   BigInt // gold minor units
  interest    BigInt
  issuedDay   Int
  redeemDay   Int
  redeemed    Boolean  @default(false)
  createdAt   DateTime @default(now())

  country Country @relation(fields: [countryId], references: [id])
  holder  Citizen @relation("bondHolder", fields: [holderId], references: [id])
}

model Subsidy {
  id          String   @id @default(cuid())
  countryId   String
  battleId    String
  goldPerHit  BigInt // minor gold units per hit
  budgetGold  BigInt
  spentGold   BigInt   @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  country Country @relation(fields: [countryId], references: [id])
}

// ============================================================================
// WARS & BATTLES
// ============================================================================

model War {
  id                String   @id @default(cuid())
  type              WarType
  attackerCountryId String? // resistance side for RW (rightful owner), rebels for CIVIL
  defenderCountryId String
  status            WarStatus @default(ACTIVE)
  attackerWins      Int      @default(0)
  defenderWins      Int      @default(0)
  rwInitiatorId     String? // citizen who paid for RW
  civilPollStatus   CivilPollStatus?
  civilPollYes      Int      @default(0)
  civilPollNo       Int      @default(0)
  civilPollEndsAt   DateTime?
  initiativeCountryId String? // winner of the last battle has the 24h attack initiative (wiki)
  initiativeUntil     DateTime?
  startedAt         DateTime @default(now())
  endedAt           DateTime?
  winnerCountryId   String?
  config            Json     @default("{}") // special-event wars: koth, halloween, roundSeconds

  battles       Battle[]
  civilPollVotes CivilPollVote[]
  attackerCountry Country? @relation("warAttacker", fields: [attackerCountryId], references: [id])
  defenderCountry Country  @relation("warDefender", fields: [defenderCountryId], references: [id])
  initiator     Citizen? @relation("rwInitiator", fields: [rwInitiatorId], references: [id])

  @@index([status])
}

/// Civil war unrest votes — voters may only fight for the side they voted for (wiki).
model CivilPollVote {
  warId     String
  citizenId String
  yes       Boolean
  votedAt   DateTime @default(now())

  war War @relation(fields: [warId], references: [id], onDelete: Cascade)

  @@id([warId, citizenId])
}

model Battle {
  id                String   @id @default(cuid())
  warId             String
  regionId          String
  attackerCountryId String
  defenderCountryId String
  roundNumber       Int      @default(1)
  status            BattleStatus @default(ACTIVE)
  startedAt         DateTime @default(now())
  endedAt           DateTime?
  winnerCountryId   String?

  war    War    @relation(fields: [warId], references: [id])
  region Region @relation(fields: [regionId], references: [id])
  rounds Round[]
  hits   BattleHit[]
}

model Round {
  id                String   @id @default(cuid())
  battleId          String
  number            Int
  startedAt         DateTime @default(now())
  endsAt            DateTime
  status            RoundStatus @default(ACTIVE)
  defenderFortQ     Int      @default(0) // fortification quality (wall + defender damage)
  attackerDamage    BigInt   @default(0)
  defenderDamage    BigInt   @default(0)
  winnerSide        BattleSide?
  hospitalExists    Boolean  @default(false)
  fortificationExists Boolean @default(false)

  battle Battle @relation(fields: [battleId], references: [id])
  hits   BattleHit[]
}

model BattleHit {
  id        String   @id @default(cuid())
  roundId   String
  battleId  String
  citizenId String
  side      BattleSide
  mode      HitMode
  damage    BigInt
  crit      Boolean  @default(false)
  missed    Boolean  @default(false)
  avoided   Boolean  @default(false)
  weaponsUsed Int    @default(0)
  hpUsed    Int      @default(0)
  createdAt DateTime @default(now())

  round  Round   @relation(fields: [roundId], references: [id])
  battle Battle  @relation(fields: [battleId], references: [id])
  citizen Citizen @relation(fields: [citizenId], references: [id])

  @@index([roundId])
  @@index([battleId, citizenId])
  @@index([citizenId])
}

// ============================================================================
// MILITARY UNITS
// ============================================================================

model MilitaryUnit {
  id            String   @id @default(cuid())
  name          String   @unique
  countryId     String
  leaderId      String
  levelIdx      Int      @default(0)
  memberSlots   Int      @default(10)
  gold          BigInt   @default(0) // vault, minor units
  recruitmentOpen Boolean @default(true)
  countryOnly   Boolean  @default(true)
  description   String?
  createdAt     DateTime @default(now())

  members MuMembership[]
  orders  MuOrder[]
  applications MuApplication[]
}

model MuMembership {
  muId       String
  citizenId  String  @unique
  rank       MuRank  @default(RECRUIT)
  joinedAt   DateTime @default(now())

  mu      MilitaryUnit @relation(fields: [muId], references: [id])
  citizen Citizen      @relation(fields: [citizenId], references: [id])
}

model MuApplication {
  id        String            @id @default(cuid())
  muId      String
  citizenId String
  message   String?
  status    MuApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())

  mu      MilitaryUnit @relation(fields: [muId], references: [id])
  citizen Citizen      @relation(fields: [citizenId], references: [id])

  @@unique([muId, citizenId])
}

model MuOrder {
  id        String   @id @default(cuid())
  muId      String
  battleId  String
  side      BattleSide
  createdAt DateTime @default(now())
  active    Boolean  @default(true)

  mu MilitaryUnit @relation(fields: [muId], references: [id])
}

// ============================================================================
// POLITICS
// ============================================================================

model Party {
  id        String   @id @default(cuid())
  name      String
  countryId String
  leaderId  String
  createdAt DateTime @default(now())

  country Country @relation(fields: [countryId], references: [id])
  leader  Citizen @relation("partyLeader", fields: [leaderId], references: [id])
  members PartyMembership[]
  candidacies Candidacy[]

  @@unique([countryId, name])
}

model PartyMembership {
  partyId   String
  citizenId String @unique
  joinedAt  DateTime @default(now())

  party   Party   @relation(fields: [partyId], references: [id])
  citizen Citizen @relation(fields: [citizenId], references: [id])
}

model Election {
  id        String        @id @default(cuid())
  countryId String
  type      ElectionType
  day       Int // server day of the election
  status    ElectionStatus @default(CANDIDATURE)
  createdAt DateTime      @default(now())

  country    Country     @relation(fields: [countryId], references: [id])
  candidacies Candidacy[]
  votes      Vote[]

  @@unique([countryId, type, day])
}

model Candidacy {
  id           String  @id @default(cuid())
  electionId   String
  citizenId    String
  partyId      String?
  presentation String?
  withdrawn    Boolean @default(false)

  election Election @relation(fields: [electionId], references: [id])
  citizen  Citizen  @relation(fields: [citizenId], references: [id])
  party    Party?   @relation(fields: [partyId], references: [id])
  votes    Vote[]

  @@unique([electionId, citizenId])
}

model Vote {
  electionId String
  citizenId  String
  candidateId String

  election  Election @relation(fields: [electionId], references: [id])
  citizen   Citizen  @relation(fields: [citizenId], references: [id])
  candidate Candidacy @relation(fields: [candidateId], references: [id])

  @@id([electionId, citizenId])
}

model CongressSeat {
  id         String   @id @default(cuid())
  countryId  String
  citizenId  String
  partyId    String?
  electedDay Int
  active     Boolean  @default(true)

  citizen Citizen @relation(fields: [citizenId], references: [id])

  @@index([countryId, active])
}

model Minister {
  countryId String
  citizenId String
  role      String // DEFENSE | FINANCE | FOREIGN_AFFAIRS

  citizen Citizen @relation(fields: [citizenId], references: [id])

  @@id([countryId, role])
}

model Law {
  id            String   @id @default(cuid())
  countryId     String
  type          LawType
  payload       Json
  proposedById  String
  status        LawStatus @default(VOTING)
  yes           Int      @default(0)
  no            Int      @default(0)
  votingEndsAt  DateTime
  executedAt    DateTime?
  createdAt     DateTime @default(now())

  country Country  @relation(fields: [countryId], references: [id])
  votes   LawVote[]
}

model LawVote {
  lawId        String
  citizenId    String
  yes          Boolean
  createdAt    DateTime @default(now())

  law     Law     @relation(fields: [lawId], references: [id])
  citizen Citizen @relation(fields: [citizenId], references: [id])

  @@id([lawId, citizenId])
}

model Treaty {
  id        String   @id @default(cuid())
  type      String // MPP | NAP | PEACE
  countryAId String
  countryBId String
  active    Boolean  @default(true)
  signedAt  DateTime @default(now())
  expiresAt DateTime?

  countryA Country @relation("treatyA", fields: [countryAId], references: [id])
  countryB Country @relation("treatyB", fields: [countryBId], references: [id])
}

// ============================================================================
// MEDIA & SOCIAL
// ============================================================================

model NewsPortal {
  id          String   @id @default(cuid())
  ownerId     String   @unique
  name        String   @unique
  avatarColor String   @default("#e8b44a") @db.VarChar(16)
  totalViews  Int      @default(0)
  goldEarned  BigInt   @default(0)
  createdAt   DateTime @default(now())

  owner       Citizen        @relation(fields: [ownerId], references: [id])
  articles    Article[]
  subscribers Subscription[]
  editors     PortalEditor[]
}

model PortalEditor {
  portalId  String
  citizenId String

  portal NewsPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)

  @@id([portalId, citizenId])
}

model Subscription {
  portalId    String
  citizenId   String
  createdAt DateTime @default(now())

  portal   NewsPortal @relation(fields: [portalId], references: [id])
  citizen   Citizen   @relation(fields: [citizenId], references: [id])

  @@id([portalId, citizenId])
}

model Article {
  id          String   @id @default(cuid())
  portalId    String
  authorId    String
  title       String
  body        String // sanitized HTML
  category    NewsCategory @default(FUN_OTHER)
  upvotes     Int      @default(0)
  views       Int      @default(0)
  createdAt   DateTime @default(now())

  portal NewsPortal @relation(fields: [portalId], references: [id])
  author    Citizen   @relation(fields: [authorId], references: [id])
  votes     ArticleVote[]
}

model ArticleVote {
  articleId String
  citizenId String

  article Article @relation(fields: [articleId], references: [id])
  citizen Citizen @relation(fields: [citizenId], references: [id])

  @@id([articleId, citizenId])
}

model Shout {
  id        String     @id @default(cuid())
  authorId  String
  scope     ShoutScope
  scopeId   String? // countryId or muId
  content   String     @db.VarChar(100)
  createdAt DateTime   @default(now())

  author Citizen @relation(fields: [authorId], references: [id])

  @@index([scope, scopeId, createdAt])
}

// ============================================================================
// PROGRESSION, LEDGER & SYSTEM
// ============================================================================

model Medal {
  id        String   @id @default(cuid())
  citizenId String
  type      String // HARD_WORKER, SUPER_SOLDIER, BATTLE_HERO, CAMPAIGN_HERO, CONGRESS_MEMBER, PRESIDENT, MEDIA_MOGLU, SOCIETY_BUILDER, RESISTANCE_HERO
  goldPaid  Int
  meta      Json?
  awardedAt DateTime @default(now())

  citizen Citizen @relation(fields: [citizenId], references: [id])

  @@index([citizenId, type])
}

model Transaction {
  id        String   @id @default(cuid())
  asset     TxAsset
  reason    TxReason
  amount    BigInt // positive = credit; negative = debit (minor units)
  fromType  String?
  fromId    String?
  toType    String?
  toId      String?
  countryId String? // required for FIAT
  meta      Json?
  createdAt DateTime @default(now())

  @@index([toId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  citizenId String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime @default(now())

  citizen Citizen @relation(fields: [citizenId], references: [id])

  @@index([citizenId, readAt])
}

model CitizenWallet {
  citizenId String
  countryId String
  amount    BigInt @default(0) // minor units

  citizen Citizen @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id])

  @@id([citizenId, countryId])
}

model GameClock {
  id              Int      @id @default(1)
  serverStart     DateTime
  lastDayDone     Int      @default(0)
  lastMonthlyDone Int      @default(0) // last 30-day period index rewarded
  lastYearlyDone  Int      @default(0) // last 365-day period index rewarded (FAK reset)
  updatedAt       DateTime @updatedAt
}

// ============================================================================
// NATIONAL ORGANISATIONS, EMBARGOS & ALLIANCES
// ============================================================================

model NationalOrganisation {
  id          String   @id @default(cuid())
  countryId   String   @unique
  name        String
  gold        BigInt   @default(0) // minor units
  fiat        BigInt   @default(0)
  createdAt   DateTime @default(now())

  country   Country   @relation(fields: [countryId], references: [id])
  companies Company[] @relation("orgCompanies")
}



model Embargo {
  id              String      @id @default(cuid())
  sourceCountryId String
  targetCountryId String
  type            EmbargoType
  until           DateTime
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())

  source Country @relation("embargoSource", fields: [sourceCountryId], references: [id])
  target Country @relation("embargoTarget", fields: [targetCountryId], references: [id])

  @@index([targetCountryId, type, active])
}

model Alliance {
  id        String   @id @default(cuid())
  name      String   @unique
  leaderId  String // country id of leader
  createdAt DateTime @default(now())

  members AllianceMember[]
}

model AllianceMember {
  allianceId String
  countryId  String
  joinedAt   DateTime @default(now())

  alliance Alliance @relation(fields: [allianceId], references: [id], onDelete: Cascade)
  country  Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@id([allianceId, countryId])
}

// ============================================================================
// BUFFS, CONTRACTS & AUCTIONS
// ============================================================================

model Buff {
  id          String    @id @default(cuid())
  citizenId   String
  type        BuffType
  buffUntil   DateTime
  debuffUntil DateTime

  citizen Citizen @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  @@index([citizenId])
}

model Contract {
  id               String         @id @default(cuid())
  type             ContractType
  creatorId        String
  counterpartyId   String?
  amountGold       BigInt // minor units
  durationDays     Int            @default(1)
  interestPct      Int            @default(0) // loans
  totalDueGold     BigInt         @default(0)
  status           ContractStatus @default(OPEN)
  auditNote        String? // public audit: "X and Y had a transaction" (no amounts)
  createdAt        DateTime       @default(now())
  completedAt      DateTime?

  creator      Citizen  @relation("contractCreator", fields: [creatorId], references: [id])
  counterparty Citizen? @relation("contractCounterparty", fields: [counterpartyId], references: [id])
}

model Auction {
  id          String           @id @default(cuid())
  sellerId    String
  kind        AuctionItemKind
  itemId      String // WA item id or special item key
  startPrice  BigInt // minor gold
  currentBid  BigInt?
  currentBidderId String?
  minOutbidPct Int             @default(3)
  endsAt      DateTime
  status      AuctionStatus   @default(ACTIVE)
  listFeePaid BigInt          @default(0) // 1% of start price
  createdAt   DateTime        @default(now())

  bids AuctionBid[]
}

model AuctionBid {
  id        String   @id @default(cuid())
  auctionId String
  bidderId  String
  amount    BigInt // minor gold
  createdAt DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder  Citizen @relation(fields: [bidderId], references: [id])

  @@index([auctionId, amount])
}

// ============================================================================
// TOURNAMENTS, STATS, ACHIEVEMENTS, CITIZENSHIP
// ============================================================================

model Tournament {
  id        String          @id @default(cuid())
  type      TournamentType
  status    TournamentStatus @default(REGISTERING)
  config    Json?
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime        @default(now())

  teams TournamentTeam[]
  matches TournamentMatch[]
}

model TournamentTeam {
  id           String  @id @default(cuid())
  tournamentId String
  name         String
  countryId    String?
  muId         String? // Army Cup: the army (MilitaryUnit) fielded
  citizenId    String? // 1v1: the individual competitor; other cups: the registering citizen
  points       Int     @default(0)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model TournamentMatch {
  id           String   @id @default(cuid())
  tournamentId String
  round        Int
  teamAId      String
  teamBId      String
  hitsA        Int      @default(0)
  hitsB        Int      @default(0)
  winnerTeamId String?
  endsAt       DateTime?
  // Round-by-round play (wiki: best-of-N, e.g. 5/9 rounds of 4 min).
  currentRound Int      @default(1)
  roundEndsAt  DateTime?
  roundWinsA   Int      @default(0)
  roundWinsB   Int      @default(0)
  roundHitsA   Int      @default(0)
  roundHitsB   Int      @default(0)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

// Per-citizen hit ledger — resolves "top damage players" for tournament rewards.
model TournamentHit {
  id           String   @id @default(cuid())
  tournamentId String
  teamId       String
  matchId      String // match id, or the tournament id itself for melee events
  citizenId    String
  hits         Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([tournamentId, citizenId, matchId])
  @@index([tournamentId, teamId])
}

model StatsRollup {
  id        String   @id @default(cuid())
  ownerType String // COUNTRY | ARMY | CITIZEN | ALLIANCE | JSC | PORTAL
  ownerId   String // polymorphic id — no FK (may reference different tables)
  day       Int
  damage    BigInt   @default(0)
  hits      Int      @default(0)

  @@unique([ownerType, ownerId, day])
  @@index([ownerType, day])
}

model Achievement {
  id           String   @id @default(cuid())
  citizenId    String
  subcategory  String // one of ACHIEVEMENT_SUBCATEGORIES
  key          String
  target       Int      @default(1)
  progress     Int      @default(0)
  completedAt  DateTime?

  @@unique([citizenId, key])
  @@index([citizenId, subcategory])
}

// Special events (wiki): Halloween (Earth vs Halloween Army), King of the Hill,
// Patriot Week. Scheduled by staff; activated/ended by the events tick.
model SpecialEvent {
  id        String   @id @default(cuid())
  type      String // HALLOWEEN | KOTH | PATRIOT_WEEK
  status    String   @default("SCHEDULED") // SCHEDULED | ACTIVE | ENDED
  startsAt  DateTime
  endsAt    DateTime
  config    Json     @default("{}") // KOTH: {countryId, regionId}; HALLOWEEN: {defenderCountryId, regionId}
  warId     String? // HALLOWEEN: the invasion war
  regionId  String? // KOTH: the hill region
  createdAt DateTime @default(now())

  @@index([status, startsAt])
}

// Like/Dislike ratings (wiki): citizens, stock companies & news portals, L13+.
model EntityRating {
  id         String   @id @default(cuid())
  voterId    String
  targetType String   // CITIZEN | STOCK_COMPANY | NEWS_PORTAL
  targetId   String
  isLike     Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([voterId, targetType, targetId])
  @@index([targetType, targetId])
}

// Shared-IP registry (wiki): max 2 accounts per IP (1 main, 1 shared);
// shared-IP accounts are excluded from referral payouts.
model SharedIpRegistration {
  id        String   @id @default(cuid())
  mainId    String // declaring account
  sharedId  String // the 2nd account on the same IP (unique — declared once)
  ip        String   @db.VarChar(45)
  createdAt DateTime @default(now())

  main   Citizen @relation("sharedIpMain", fields: [mainId], references: [id])
  shared Citizen @relation("sharedIpShared", fields: [sharedId], references: [id])

  @@unique([sharedId])
  @@index([ip])
}

// eSocialis friends (wiki): request/accept graph between citizens.
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING") // PENDING | ACCEPTED
  createdAt   DateTime @default(now())

  requester Citizen @relation("friendRequester", fields: [requesterId], references: [id])
  addressee Citizen @relation("friendAddressee", fields: [addresseeId], references: [id])

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

// Private messages (wiki): direct citizen-to-citizen mail.
model PrivateMessage {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  body        String    @db.VarChar(2000)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  sender    Citizen @relation("pmSender", fields: [senderId], references: [id])
  recipient Citizen @relation("pmRecipient", fields: [recipientId], references: [id])

  @@index([recipientId, readAt])
  @@index([senderId, recipientId, createdAt])
}

model CitizenshipRequest {
  id          String   @id @default(cuid())
  requesterId String
  fromCountryId String
  toCountryId   String
  sponsorId     String?
  status        String   @default("VOTING") // VOTING | ACCEPTED | REJECTED
  createdAt     DateTime @default(now())
  closesAt      DateTime

  requester Citizen @relation("citizenshipRequester", fields: [requesterId], references: [id])

  @@index([toCountryId, status])
}

model JscPoll {
  id        String   @id @default(cuid())
  jscId     String
  kind      String // ISSUE_SHARES | DIVIDENDS | SET_PRICE | IMPEACH_CEO
  payload   Json
  yesWeight BigInt   @default(0)
  noWeight  BigInt   @default(0)
  closesAt  DateTime
  executed  Boolean  @default(false)
  status    String   @default("VOTING") // VOTING | PASSED | REJECTED

  jsc   StockCompany  @relation(fields: [jscId], references: [id])
  votes JscPollVote[]

  @@index([jscId])
}

model JscPollVote {
  id        String  @id @default(cuid())
  pollId    String
  citizenId String
  yes       Boolean
  weight    Int // shares held at vote time

  poll JscPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, citizenId])
}

model CountryChatMessage {
  id        String   @id @default(cuid())
  countryId String
  authorId  String
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now())

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  author  Citizen @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([countryId, createdAt])
}

